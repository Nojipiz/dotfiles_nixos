[
  {
    "label": "start lazygit",
    "command": "lazygit -p $ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "reveal_target": "center",
    "allow_concurrent_runs": false,
    "hide": "always"
  },
  {
      "label": "start opencode",
      "command": "opencode",
      "use_new_terminal": true,
      "reveal_target": "dock",
      "allow_concurrent_runs": false,
      "hide": "never"
  },
  {
    "label": "setup worktree",
    "command": "$HOME/.config/zed/scripts/run-or-compile.sh $HOME/.config/zed/scripts/setup-worktree.scala",
    "cwd": "$ZED_WORKTREE_ROOT",
    "hooks": ["create_worktree"]
  }
]
